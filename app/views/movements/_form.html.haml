= form_for @movement do |f|
  - if @movement.errors.any?
    #error_explanation
      %h2= "#{pluralize(@movement.errors.count, "error")} prohibited this movement from being saved:"
      %ul
        - @movement.errors.full_messages.each do |message|
          %li= message

  .field
    = f.label :description
    = f.text_field :description
  .field
    = f.label :movement_type
    = f.number_field :movement_type
  .field
    = f.label :value
    = f.text_field :value
  .field
    = f.label :user
    = f.text_field :user
  .actions
    = f.submit 'Save'
