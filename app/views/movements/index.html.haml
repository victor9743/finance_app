%h1 Listing movements

%table
  %thead
    %tr
      %th Description
      %th Movement type
      %th Value
      %th User
      %th
      %th
      %th

  %tbody
    - @movements.each do |movement|
      %tr
        %td= movement.description
        %td= movement.movement_type
        %td= movement.value
        %td= movement.user.name
        %td= link_to 'Show', movement
        %td= link_to 'Edit', edit_movement_path(movement)
        %td= link_to 'Destroy', movement, method: :delete, data: { confirm: 'Are you sure?' }

%br

= link_to 'New Movement', new_movement_path
